# Production env (F18) — `cp .env.prod.example .env.prod && chmod 600 .env.prod`
# Gizli değerler BURADA DEĞİL: secrets/{db_password,jwt_secret,smtp_password} dosyalarında
# (compose DB_PASSWORD_FILE / JWT_SECRET_FILE / SMTP_PASSWORD_FILE olarak verir).
# APP_ENV, DB_HOST, DB_PORT, TRUSTED_PROXIES compose tarafından sabitlenir.

# === Compose (yalnızca docker compose okur) ===
TAG=v0.1.0
GHCR_OWNER=your-org
HTTP_PORT=80
HTTPS_PORT=443
BACKUP_AGE_RECIPIENT=

# === Uygulama ===
APP_PORT=8080
APP_BASE_URL=https://todo.example.com
WEB_BASE_URL=https://todo.example.com

# === Veritabanı ===
DB_NAME=todo
DB_USER=todo
DB_SSL=false
# Bütçe: 2 replika × worker_processes × DB_POOL_SIZE ≤ max_connections(100) − 10
DB_POOL_SIZE=20
DB_POOL_IDLE_TIMEOUT_MS=60000
DB_CONNECT_TIMEOUT_MS=3000
DB_QUERY_TIMEOUT_MS=10000

# === JWT ===
JWT_ISSUER=todo-api
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# === Argon2id (OWASP: m_cost ≥ 15 → 32 MiB; RAM'e göre) ===
ARGON2_T_COST=3
ARGON2_M_COST=15
ARGON2_PARALLELISM=1

# === Auth ===
PASSWORD_RESET_TTL=3600
LOGIN_RATE_LIMIT=5

# === SMTP ===
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@todo.example.com
SMTP_FROM=no-reply@todo.example.com
SMTP_TLS=true

# === HTTP ===
CORS_ORIGINS=https://todo.example.com

# === Log ===
LOG_FORMAT=json
LOG_LEVEL=info

# === Audit temizlik (saat UTC) ===
AUDIT_LOG_RETENTION_DAYS=30
AUDIT_CLEANUP_ENABLED=true
AUDIT_CLEANUP_HOUR=3
AUDIT_CLEANUP_BATCH_SIZE=1000

# === Seed / RBAC ===
SEED_DEFAULTS=false
RBAC_CACHE_TTL=60
